<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="style.css">
    <title>Detalhadamento do motorista</title>
</head>

<body>
    <div class="container">
        <header>
            
            <img src="imgs/profile.png" class="zoom" alt="fotoPerfil">
            <h1 id="nameHeader"> Nome</h1>
            <p class="legenda">Motorista de van</p>
        </header> 

        <section class="botoes-links">
            <div class="motorista degrade" id="nomeMotorista">
                <span>Alterar nome do motorista</span>
            </div>

            <div class="motorista degrade" id="idadeMotorista">
                <span>Alterar idade</span>
            </div>

            <div class="motorista degrade" id="horariosDisponiveis">
                <span>Alterar horarios disponiveis</span>
            </div>

            <div class="motorista degrade" id="tempoExperiencia">
                <span>Alterar tempo de experiencia</span>
            </div>

            <div class="motorista degrade" id="nomeMotorista2">
                <span>Alterar nome do motorista</span>
            </div>
            <div class="motorista degrade" id="emailMotorista">
                <span>Alterar email</span>
            </div>
            
            <div class="motorista degrade" id="whatsappMotorista">
                <span>Alterar whatsapp</span>
            </div>
        </section>

        <footer>
            <a href="https://web.whatsapp.com" class="btn_footer degrade" target="_blank"><i class="bi bi-whatsapp"></i></a>
            <a href="https://www.google.com/intl/pt-BR/gmail/about/" class="btn_footer degrade" target="_blank"><i class="bi bi-envelope"></i></a>
            
            <button id="clearButton" class="btn_footer degrade"><i class="bi bi-trash"></i></button>
            <div class="container-fluid">
                <div class="row">
                  <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    <center>
                      <p style="font-size: 13px;" id="Copyright">Copyright - Todos os direitos reservados a Van Connect</p>
                    </center>
                  </div>
                </div>
            </div>
        </footer>
    </div>
    <script src="script.js"></script>
    
</body>

</html>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
}
html {
  height: 100vh;
  font-size: 14px;
}
a{
    text-decoration: none;
    color: black;
}
.degrade{
    background: linear-gradient(to right, rgba(255, 255, 255, 0.705),rgba(250, 250, 31, 0.404));
}
body {
  background-color: rgba(250, 250, 31, 0.404);
  height: 100%;
}
.container {
  height: 100%;
  max-width: 550px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px;
  color: black;
}
.zoom:hover {
  cursor: pointer;
  transition: 1s;
  -ms-transform: scale(4.0) translateY(50%);
  -webkit-transform: scale(4.0) translateY(50%);
  transform: scale(4.0) translateY(50%);
}
header {
  text-align: center;
  margin-bottom: 40px;
}
header img {
  border-radius: 50px;
  max-width: 120px;
  margin-bottom: 20px;
}
header h1 {
  font-size: 2em;
  margin-bottom: 10px;
  color: black;
  font-weight: 300;
}
section.botoes-links {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
a.link button {
  width: 100%;
  padding: 10px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 30px;
  font-size: 1.2em;
  cursor: pointer;
  transition: .3s;
}
a.link i{
    font-size: 1.5em;
}
a.link button:hover, a.btn_footer:hover{
    transform: scale(1.05);
    
}
.motorista {
  width: 100%; 
  padding: 10px 20px; 
  border: 2px solid black; 
  border-radius: 30px;
  box-sizing: border-box; 
  font-size: 1.2em; 
  cursor: pointer; 
  transition: .3s; 
}
#nameHeader{
  cursor: pointer; 
  text-decoration: underline;
}
.legenda{
  font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
}
footer{
    text-align: center;
    margin: 25px;
}
footer a.btn_footer{
    width: 60px;
    height: 60px;
    display: inline-block;
    font-size: 2em;
    line-height: 60px;
    border-radius: 50%;
    margin: 0 10px;
    transition: 3s;
    border: 2px solid black;
}
#clearButton{
  width: 60px;
    height: 60px;
    display: inline-block;
    font-size: 2em;
    line-height: 60px;
    border-radius: 50%;
    margin: 0 10px;
    transition: 3s;
    border: 2px solid black;
    cursor: pointer;
}
#Copyright{
  margin-top: 12px !important;
}
document.addEventListener('DOMContentLoaded', function() {
    var img = document.querySelector('.zoom');
    var motoristaData = {
        nome: '',
        idade: '',
        whatsapp: '',
        outrosDados: {}
    };

    function salvarDadosLocalStorage() {
        localStorage.setItem('motoristaData', JSON.stringify(motoristaData));
    }

    function limparLocalStorage() {
        localStorage.clear();
    }

    img.addEventListener('click', function() {
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/jpeg';
        fileInput.addEventListener('change', function() {
            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    motoristaData.imgSrc = e.target.result;  
                    salvarDadosLocalStorage();
                };
                reader.readAsDataURL(file);
            }
        });
        fileInput.click();
    });

    var motoristaDivs = document.querySelectorAll('.motorista');
    
    motoristaDivs.forEach(function(div) {
        div.addEventListener('click', function() {
            var novoTexto = prompt("Digite:", this.querySelector('span').textContent);
            if (novoTexto !== null && novoTexto.trim() !== '') {
                this.querySelector('span').textContent = novoTexto;
                motoristaData.outrosDados[div.id] = novoTexto;
                salvarDadosLocalStorage();
            } else {
                alert("Por favor, insira uma informação válida.");
            }
        });
    });

    var nameHeader = document.querySelector('h1');
    nameHeader.addEventListener('click', function() {
        var novoTexto = prompt("Digite o nome:", this.textContent);
        if (novoTexto !== null && novoTexto.trim() !== '') {
            this.textContent = novoTexto;
            motoristaData.nome = novoTexto;
            salvarDadosLocalStorage();
        } else {
            alert("Por favor, insira um nome válido.");
        }
    });

    var idadeDiv = document.querySelector('#idadeMotorista');
    idadeDiv.addEventListener('click', function() {
        var novoTexto = prompt("Digite a idade:", motoristaData.idade || "");
        if (novoTexto !== null && !isNaN(novoTexto.trim()) && novoTexto.trim() !== '') {
            this.querySelector('span').textContent = novoTexto;
            motoristaData.idade = novoTexto;
            salvarDadosLocalStorage();
        } else {
            alert("Por favor, insira um número válido para a idade.");
        }
    });

    var whatsappDiv = document.querySelector('#whatsappMotorista');
    whatsappDiv.addEventListener('click', function() {
        var novoTexto = prompt("Digite o número do WhatsApp:", motoristaData.whatsapp || "");
        if (novoTexto !== null && !isNaN(novoTexto.trim()) && novoTexto.trim() !== '') {
            this.querySelector('span').textContent = novoTexto;
            motoristaData.whatsapp = novoTexto;
            salvarDadosLocalStorage();
        } else {
            alert("Por favor, insira apenas números para o WhatsApp.");
        }
    });

    var clearButton = document.getElementById('clearButton');
    clearButton.addEventListener('click', function() {
        limparLocalStorage();
        motoristaData = {
            nome: '',
            idade: '',
            whatsapp: '',
            outrosDados: {}
        };
        document.location.reload(true);
    });

    var dadosLocalStorage = localStorage.getItem('motoristaData');
    if (dadosLocalStorage) {
        motoristaData = JSON.parse(dadosLocalStorage);
        if (motoristaData.nome) {
            document.querySelector('h1').textContent = motoristaData.nome;
        }
        if (motoristaData.idade) {
            document.querySelector('#idadeMotorista span').textContent = motoristaData.idade;
        }
        if (motoristaData.whatsapp) {
            document.querySelector('#whatsappMotorista span').textContent = motoristaData.whatsapp;
        }
        if (motoristaData.imgSrc) {
            img.src = motoristaData.imgSrc;
        }
        for (var key in motoristaData.outrosDados) {
            if (motoristaData.outrosDados.hasOwnProperty(key)) {
                var element = document.getElementById(key);
                if (element) {
                    element.querySelector('span').textContent = motoristaData.outrosDados[key];
                }
            }
        }
    }
});


